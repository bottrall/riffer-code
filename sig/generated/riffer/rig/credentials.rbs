  # Saves an API key for +provider+ to the auth file with 0600 permissions.
  def save_api_key: (untyped provider, untyped key, ?path: untyped) -> untyped

  private

  def key_from_file: (untyped provider, untyped path) -> untyped

  def read: (untyped path) -> untyped
end
